{
  "name": "zetagrow",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["website", "admin"],
  "scripts": {
    "dev:website": "npm run dev --workspace=website",
    "dev:admin": "npm run dev --workspace=admin",
    "build:website": "npm run build --workspace=website",
    "build:admin": "npm run build --workspace=admin",
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "convex": "^1.17.4",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "resend": "^6.22.0"
  }
}
