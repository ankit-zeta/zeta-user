# ── ZetaGrow Website (public) — Vercel Environment Variables ──
# Set these in Vercel: Project → Settings → Environment Variables

# Convex production deployment (required)
NEXT_PUBLIC_CONVEX_URL=https://terrific-dove-836.convex.cloud

# Convex deployment ID (required for npx convex deploy)
CONVEX_DEPLOYMENT=your_convex_deployment_id

# Public site URL (used for canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://zetagrow.in
