# ── ZetaGrow Admin — Vercel Environment Variables ──
# Set these in Vercel: Project → Settings → Environment Variables

# Convex production deployment (required)
NEXT_PUBLIC_CONVEX_URL=https://terrific-dove-836.convex.cloud

# Convex deployment ID (required for npx convex deploy)
CONVEX_DEPLOYMENT=your_convex_deployment_id

# Admin panel URL (optional, for internal references)
NEXT_PUBLIC_SITE_URL=https://admin.zetagrow.in

# ⚠️ SECURITY: Restrict access to this deployment via Vercel:
#   Settings → Deployment Protection → Password/SSO protection
#   (the admin app has its own auth, but network-level protection adds a layer)
